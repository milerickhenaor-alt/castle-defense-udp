import pygame
import os
from view.renderer import SpriteLoader
from utils.constants import *

class EnemyView:
    def __init__(self, enemy_type):
        base = f"assets/enemies/{enemy_type}"

        self.walk = self.load_animation(base + "/walk")
        self.hit = self.load_animation(base + "/hit")
        self.attack = self.load_animation(base + "/attack")
        self.death = self.load_animation(base + "/death")

        self.frame_index = 0

    def load_animation(self, path):
        frames = []
        for file in sorted(os.listdir(path)):
            img = pygame.image.load(os.path.join(path, file))
            frames.append(img)
        return frames

    def draw(self, screen, enemy):
        # Elegir animación según estado
        if enemy.health <= 0:
            frames = self.death

        elif enemy.state == ENEMY_STATE_ATTACK:
            frames = self.attack

        elif enemy.state == ENEMY_STATE_HIT:
            frames = self.hit

        else:
            frames = self.walk

        # Dibujar frame actual
        image = frames[self.frame_index]
        screen.blit(image, (enemy.x, enemy.y))

        # Avanzar animación
        self.frame_index = (self.frame_index + 1) % len(frames)